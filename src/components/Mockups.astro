---
// Mockups ilustrativos do hero. Dados fictícios e genéricos; decorativos (aria-hidden).
---

<div class="relative mx-auto h-[560px] w-[262px] lg:h-[620px] lg:w-[820px]" aria-hidden="true">
  <!-- Notebook (só a partir de lg) -->
  <div class="absolute top-10 left-0 hidden w-[664px] drop-shadow-[0_24px_36px_rgb(60_50_40/0.18)] lg:block">
    <div class="w-[664px] rounded-2xl bg-[#3a3632] px-3 pt-3">
      <div class="flex h-[400px] w-[640px] flex-col overflow-hidden rounded-md bg-paper">
        <div class="flex h-7 flex-none items-center gap-[7px] border-b border-line bg-[#eee8df] px-3">
          <i class="block size-[9px] rounded-full bg-[#e3a29b]"></i>
          <i class="block size-[9px] rounded-full bg-[#e6c68c]"></i>
          <i class="block size-[9px] rounded-full bg-[#a8c9b5]"></i>
          <div class="ml-3.5 rounded-md bg-paper px-3.5 py-[3px] text-[11px] text-muted">
            app.anvello.com.br
          </div>
        </div>
        <div class="flex min-h-0 flex-1 overflow-hidden">
          <div class="flex w-[200px] flex-none flex-col gap-2 border-r border-line bg-cream px-3.5 py-4">
            <div class="rounded-[10px] border border-line bg-paper px-3 py-[9px] text-xs text-subtle">
              Buscar sintoma…
            </div>
            <div class="rounded-[10px] bg-mint px-3 py-[11px] text-brand-deep">
              <div class="text-[13px] font-semibold">Cefaleia tensional</div>
              <div class="text-[11px] text-[#4d7a6d]">Adulto</div>
            </div>
            <div class="px-3 py-[11px]">
              <div class="text-[13px] font-medium">Lombalgia aguda</div>
              <div class="text-[11px] text-subtle">Adulto</div>
            </div>
            <div class="px-3 py-[11px]">
              <div class="text-[13px] font-medium">Faringite viral</div>
              <div class="text-[11px] text-subtle">Pediátrico · dose por peso</div>
            </div>
            <div class="px-3 py-[11px]">
              <div class="text-[13px] font-medium">Rinite alérgica</div>
              <div class="text-[11px] text-subtle">Adulto</div>
            </div>
          </div>
          <div class="flex min-w-0 flex-1 flex-col gap-3.5 py-5 pr-[128px] pl-[26px] text-ink">
            <div class="text-[21px] leading-tight font-semibold">Cefaleia tensional — adulto</div>
            <div class="flex flex-col gap-2.5 text-sm leading-[1.6] text-[#4a4640]">
              <div>1. Paracetamol 750 mg — 1 comprimido via oral a cada 8 horas, se dor, por até 3 dias.</div>
              <div>2. Orientações: hidratação, pausas de tela, retorno se piora ou sinais de alarme.</div>
            </div>
            <div class="mt-auto">
              <span class="inline-block rounded-[10px] bg-brand px-6 py-[11px] text-sm font-medium text-white">Copiar receita</span>
            </div>
          </div>
        </div>
      </div>
      <div class="h-[30px]"></div>
    </div>
    <div class="mx-auto h-14 w-[84px] bg-[linear-gradient(90deg,#cfc7bb,#e8e1d7_45%,#cfc7bb)]"></div>
    <div class="mx-auto h-3 w-[220px] rounded-[50%_50%_8px_8px/100%_100%_8px_8px] bg-[linear-gradient(#e8e1d7,#bfb6a8)]"></div>
  </div>

  <!-- Celular -->
  <div class="absolute top-0 right-0 h-[560px] w-[262px] drop-shadow-[0_24px_36px_rgb(60_50_40/0.22)] lg:top-10">
    <div class="relative h-[860px] w-[402px] origin-top-left scale-[.65]">
      <div class="h-[860px] w-[402px] rounded-[64px] bg-[#3a3632] p-3">
        <div class="relative size-full overflow-hidden rounded-[52px] bg-cream">
          <div class="absolute top-3 left-1/2 z-[3] -ml-[59px] h-[34px] w-[118px] rounded-[20px] bg-[#1d1b19]"></div>
          <div class="absolute top-3.5 left-[34px] z-[3] text-[17px] font-semibold text-ink">9:41</div>
          <div class="flex h-full flex-col gap-4 overflow-hidden px-5 pt-[62px] pb-10 text-ink">
            <div class="flex items-end gap-0.5 pt-1.5 text-[25px] leading-none font-semibold tracking-[.05em]">
              <svg viewBox="1 2 38 40" fill="none" class="mb-[3px] block h-5 w-[19px] flex-none">
                <polygon points="20,2 39,42 29,42 20,17 11,42 1,42" fill="#2f6f62"></polygon>
                <circle cx="20" cy="36" r="2.9" fill="#f7f3ee"></circle>
              </svg>
              <span>NVELLO</span>
            </div>
            <div class="rounded-2xl border border-line bg-paper px-[18px] py-[15px] text-[17px] text-subtle">
              Buscar sintoma ou quadro…
            </div>
            <div class="flex flex-col gap-3.5 rounded-[22px] bg-paper px-[22px] py-6 shadow-[0_1px_0_#e8e1d7]">
              <div class="text-[26px] leading-[1.15] font-semibold">Cefaleia tensional — adulto</div>
              <div class="text-base leading-[1.6] text-[#4a4640]">
                1. Paracetamol 750 mg — 1 comprimido via oral a cada 8 horas, se dor, por até 3 dias.
              </div>
              <div class="text-base leading-[1.6] text-[#4a4640]">
                2. Orientações: hidratação, pausas de tela, retorno se piora.
              </div>
            </div>
            <div class="rounded-[18px] bg-brand p-[19px] text-center text-lg font-medium text-white">Copiar receita</div>
            <div class="rounded-2xl bg-paper px-[18px] py-4">
              <div class="text-base font-medium">Lombalgia aguda</div>
              <div class="text-[13px] text-subtle">Adulto</div>
            </div>
          </div>
          <div class="absolute bottom-2 left-1/2 z-[3] -ml-[67px] h-[5px] w-[134px] rounded-[3px] bg-black/30"></div>
        </div>
      </div>
    </div>
  </div>
</div>
