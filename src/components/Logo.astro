---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  product?: string;
  dark?: boolean;
}
const { size = 'md', product, dark = false } = Astro.props;
const text = { sm: 'text-[17px]', md: 'text-2xl', lg: 'text-[25px]' }[size];
const svg = { sm: 'h-3.5 w-[13px]', md: 'h-[19px] w-[18px]', lg: 'h-5 w-[19px]' }[size];
---

<span
  class:list={[
    'flex items-end gap-0.5 leading-none font-bold tracking-[.06em]',
    text,
    dark ? 'text-[#f2f2f3]' : 'text-ink',
  ]}
  role="img"
  aria-label={product ? `Anvello ${product}` : 'Anvello'}
>
  <svg viewBox="1 2 38 40" fill="none" class:list={[svg, 'mb-[3px] block flex-none']} aria-hidden="true">
    <polygon points="20,2 39,42 29,42 20,17 11,42 1,42" fill="#2f6f62"></polygon>
    <circle cx="20" cy="36" r="2.9" fill={dark ? '#16181a' : '#f7f3ee'}></circle>
  </svg>
  <span aria-hidden="true">NVELLO</span>
  {
    product && (
      <span
        class:list={[
          'mb-0.5 ml-2.5 text-[13px] font-medium tracking-[.12em]',
          dark ? 'text-[#7fb3a6]' : 'text-brand',
        ]}
        aria-hidden="true"
      >
        {product}
      </span>
    )
  }
</span>
