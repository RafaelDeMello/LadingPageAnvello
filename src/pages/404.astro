---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---

<Layout title="Página não encontrada | Anvello" noindex>
  <div class="page-bg flex min-h-screen min-w-0 flex-col">
    <Header />
    <main id="conteudo" class="flex flex-1 flex-col items-start justify-center gap-6 px-[clamp(20px,5vw,64px)] py-20">
      <p class="font-condensed text-6xl leading-none font-bold text-brand">404</p>
      <h1 class="text-[clamp(30px,3.6vw,46px)] leading-[1.15] font-bold">Página não encontrada</h1>
      <p class="max-w-[46ch] text-lg text-muted">O endereço que você tentou abrir não existe ou mudou de lugar.</p>
      <Button href="/" size="lg">Voltar ao início</Button>
    </main>
    <Footer />
  </div>
</Layout>
